#!/usr/bin/env node
// mail — agent003's own email: agent003@a9n9.net and arun@genxlinked.com.
//   mail list [--all]                       messages not yet handled (--all: last 14 days, handled too)
//   mail read <id>                          one message in full
//   mail reply <id> --file <path> [--operator '<what the operator must do>']
//                                           reply from the address it was sent to (threaded); marks it handled
//   mail done <id> '<why no reply>' [--operator '<what the operator must do>']
//   mail pitch <to-address> --subject '<subject>' --file <path>
//                                           FIRST-CONTACT email to one outside person (press, partner orgs), from
//                                           stories@genxlinked.com. Caps: 3/day, 10/week, one pitch per person per
//                                           30 days, no follow-ups (if they reply, answer with mail reply). Must link
//                                           the genxlinked.com page. The AI-disclosure footer is added by the service.
//   mail suppress <address> '<why>'         never pitch this address again (they said no / asked to stop)
// The mail service only shows mail sent to your addresses. Replies: 20 a day; signature and disclosure added for you.
import fs from 'node:fs';
import { HOME, out, env, paused } from './_kit.mjs';
const argv = process.argv.slice(2);
const take = (flag) => { const i = argv.indexOf(flag); if (i < 0) return undefined; const v = argv[i + 1]; argv.splice(i, 2); return v; };
const all = argv.includes('--all'); if (all) argv.splice(argv.indexOf('--all'), 1);
const file = take('--file'); const operator = take('--operator');
const [cmd, id, note] = argv;
const sf = `${HOME}/secrets/mail.env`;
if (!fs.existsSync(sf)) { out({ ok: false, error: 'mail is not set up yet (no secrets/mail.env)' }); process.exit(3); }
const { MAIL_URL, MAIL_KEY } = env(sf);
const call = async (path, body) => {
  const r = await fetch(`${MAIL_URL}${path}`, { method: body ? 'POST' : 'GET', headers: { authorization: `Bearer ${MAIL_KEY}`, ...(body ? { 'content-type': 'application/json' } : {}) }, ...(body ? { body: JSON.stringify(body) } : {}), signal: AbortSignal.timeout(20000) });
  const j = await r.json().catch(() => ({}));
  if (!r.ok) { out({ ok: false, status: r.status, error: j.error ?? 'request failed' }); process.exit(1); }
  return j;
};
const isId = (s) => /^[0-9a-f-]{36}$/.test(s ?? '');
if (cmd === 'list') {
  const j = await call(`/v1/agent/mail${all ? '?all=1' : ''}`);
  out({ ok: true, addresses: j.addresses, count: j.mail.length, mail: j.mail, next: j.mail.length ? 'mail read <id>, then mail reply <id> --file <path> or mail done <id> <why>' : 'nothing to answer' });
} else if (cmd === 'read' && isId(id)) {
  out({ ok: true, ...(await call(`/v1/agent/mail/${id}`)) });
} else if (cmd === 'reply' && isId(id) && file) {
  if (paused()) { out({ ok: false, error: `paused: ${paused()}` }); process.exit(4); }
  const msg = await call(`/v1/agent/mail/${id}`);
  let body = fs.readFileSync(file, 'utf8').trim();
  if (body.length < 20) { out({ ok: false, error: 'reply is too short to be useful' }); process.exit(2); }
  const desk = /@genxlinked\.com$/i.test(msg.to);
  body += desk
    ? '\n\n—\nThe GenXLinked desk (https://genxlinked.com)\nThis reply was written by agent003, an AI agent working with Arun, not by Arun himself. Arun reads every message too.'
    : '\n\n—\nagent003, the GenXLinked desk: an AI agent run by a9n9 (a Visybl Inc service) for https://genxlinked.com, not a person.';
  const j = await call(`/v1/agent/mail/${id}/reply`, { text: body, ...(operator ? { operator } : {}) });
  fs.appendFileSync(`${HOME}/state/mail.jsonl`, JSON.stringify({ at: new Date().toISOString(), kind: 'reply', id, to: j.to, from: j.from, subject: j.subject, operator: operator ?? null }) + '\n');
  out(j);
} else if (cmd === 'pitch' && id && file) {
  if (paused()) { out({ ok: false, error: `paused: ${paused()}` }); process.exit(4); }
  const subject = take('--subject') ?? argv[2];
  const text = fs.readFileSync(file, 'utf8').trim();
  const j = await call('/v1/agent/pitch', { to: id, subject, text });
  fs.appendFileSync(`${HOME}/state/mail.jsonl`, JSON.stringify({ at: new Date().toISOString(), kind: 'pitch', to: j.to, from: j.from, subject: j.subject, id: j.id }) + '\n');
  out(j);
} else if (cmd === 'suppress' && id && note) {
  const j = await call('/v1/agent/suppress', { to: id, note });
  fs.appendFileSync(`${HOME}/state/mail.jsonl`, JSON.stringify({ at: new Date().toISOString(), kind: 'suppress', to: id, note }) + '\n');
  out(j);
} else if (cmd === 'done' && isId(id) && note) {
  const j = await call(`/v1/agent/mail/${id}/done`, { note, ...(operator ? { operator } : {}) });
  fs.appendFileSync(`${HOME}/state/mail.jsonl`, JSON.stringify({ at: new Date().toISOString(), kind: 'done', id, note, operator: operator ?? null }) + '\n');
  out(j);
} else {
  out({ ok: false, error: "usage: mail list [--all] | mail read <id> | mail reply <id> --file <path> [--operator '<ask>'] | mail done <id> '<why>' [--operator '<ask>'] | mail pitch <to> --subject '<s>' --file <path> | mail suppress <address> '<why>'" }); process.exit(2);
}
