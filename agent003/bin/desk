#!/usr/bin/env node
// desk — the GenXLinked publishing desk (your only way into Ghost).
//   desk status                                   what is published, drafts, members, poll votes, today's usage
//   desk draft <file.md>                          create/update a Ghost DRAFT from Markdown (house rules checked, infographic built)
//   desk get <slug>                               the current Markdown of a draft
//   desk image <slug> '<story beat>' '<object>'   comic header panel in the house style (2 a day)
//   desk publish <slug> [--substack]              publish a draft now (2 a day); --substack queues it for Arun's Substack import
import fs from 'node:fs';
import { env, out, paused } from './_kit.mjs';
const p = paused(); if (p) { out({ ok: false, error: `paused by the operator: ${p}` }); process.exit(3); }
const { DESK_URL, DESK_TOKEN } = env('/agent/secrets/desk.env');
const argv = process.argv.slice(2), sub = argv.includes('--substack'), a = argv.filter((x) => x !== '--substack');
const call = async (method, path, body) => {
  const r = await fetch(`${DESK_URL}${path}`, { method, headers: { authorization: `Bearer ${DESK_TOKEN}`, 'content-type': 'application/json' }, ...(body ? { body: JSON.stringify(body) } : {}), signal: AbortSignal.timeout(240000) });
  const j = await r.json().catch(() => ({ error: `HTTP ${r.status}` })); out({ ok: r.ok, ...j }); process.exit(r.ok ? 0 : 1);
};
const [cmd, x, y, z] = a;
if (cmd === 'status') await call('GET', '/desk/status');
else if (cmd === 'draft' && x) { if (!fs.existsSync(x)) { out({ ok: false, error: `no file ${x}` }); process.exit(2); } await call('POST', '/desk/draft', { markdown: fs.readFileSync(x, 'utf8') }); }
else if (cmd === 'get' && x) await call('GET', `/desk/draft/${encodeURIComponent(x)}`);
else if (cmd === 'image' && x && y) await call('POST', '/desk/image', { slug: x, beat: y, object: z || 'one analog object from the 1980s' });
else if (cmd === 'publish' && x) await call('POST', '/desk/publish', { slug: x, substack: sub });
else { out({ ok: false, error: "usage: desk status | draft <file.md> | get <slug> | image <slug> '<beat>' '<object>' | publish <slug> [--substack]" }); process.exit(2); }
