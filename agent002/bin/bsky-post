#!/usr/bin/env node
// bsky-post — post on Bluesky from the game's bot account, or answer somebody who wrote to it.
//   bsky-post '<text>' [--tag <word>]            a post; the tool attaches the game's link card itself (never put a link in the text)
//   bsky-post '<text>' --reply-to <at-uri> [--card]   answer a post from `bsky-read notifications`; --card adds the link card (when they ask where to play)
// Rules in code: 3 posts and 10 replies a day; 300 characters; no links, no @mentions, at most 3 hashtags (not the ones that feed
// real-food or no-AI feeds); nothing about television, real chefs, newspapers, prizes or money; you never speak as a person or as
// the maker; replies only to people who wrote to the account first, once each; no repeats within 48 hours; a post needs a
// prediction (predict add --metric game.visits --subject agent …) from the last 7 days. The account's profile must say it is a bot.
// No likes, follows or reposts. A host audit reads the account's public feed and pauses you if anything there breaks these rules.
import { predictionGate } from './_predict.mjs';
import { STATE, out, counter, paused, readJsonl, append, overlap } from './_kit.mjs';
import { publicBase, link, TAG, bannedProblem, BLOCKED_TAGS, DISCLOSED, CARD } from './_game.mjs';
import { ready, NOT_READY, session, xrpc, graphemes, tagFacets } from './_bsky.mjs';
const argv = process.argv.slice(2); const take = (f) => { const i = argv.indexOf(f); if (i < 0) return undefined; const v = argv[i + 1]; argv.splice(i, 2); return v; };
const flag = (f) => { const i = argv.indexOf(f); if (i < 0) return false; argv.splice(i, 1); return true; };
const fail = (error, code = 2) => { out({ ok: false, error }); process.exit(code); };
const replyTo = take('--reply-to'); const tag = take('--tag'); const card = flag('--card'); const text = (argv[0] ?? '').trim();
if (!text || /^-/.test(text) || argv.length > 1) fail("usage: bsky-post '<text>' [--tag <word>] | bsky-post '<text>' --reply-to <at-uri> [--card]");
{ const p = paused(); if (p) fail(`paused by the operator: ${p}`, 4); }
if (!publicBase()) fail('the game has no public address yet, so there is nothing to link to. Use the run to prepare (strategy, predictions, drafts in your workspace); `game link` tells you when it is live.', 4);
if (!ready()) fail(NOT_READY, 4);
if (tag !== undefined && (replyTo || !TAG.test(tag))) fail('--tag is for posts only: one word, lowercase letters and digits, at most 12 (it becomes ?s=bsky-<tag> so you can tell which post sent players)');
if (replyTo && !/^at:\/\/did:[a-z0-9:.%-]+\/app\.bsky\.feed\.post\/[a-z0-9]+$/i.test(replyTo)) fail('--reply-to takes the uri of a post from `bsky-read notifications`');
const n = graphemes(text); if (n > 300) fail(`${n} characters: Bluesky allows 300`);
if (n < 20) fail('too short to say anything');
if (/https?:\/\/|www\.|\b[a-z0-9-]{2,}\.(com|net|org|io|dev|app|co|xyz|gg|me|ly|social|games?)\b/i.test(text)) fail('no links or site names in the text: the tool attaches the game\'s card to a post (and to a reply with --card)');
if (/@/.test(text)) fail('no @mentions: you answer people with --reply-to, and you do not call anyone in');
if (/🍜/u.test(text)) fail('the 🍜 emoji drops a post into a feed meant for real food; leave it out');
{ const b = bannedProblem(text); if (b) fail(`${b}. Rewrite it without that.`); }
const { facets, tags } = tagFacets(text);
if (tags.length > 3) fail(`${tags.length} hashtags: at most 3`);
{ const bad = tags.find((t) => BLOCKED_TAGS.has(t)); if (bad) fail(`#${bad} puts the post into a feed whose rules it would break (real food, or no AI art). Pick tags about what it is: a browser cooking game.`); }
const LOG = `${STATE}/bsky-posts.jsonl`; const log = readJsonl(LOG);
{ const prev = log.filter((x) => Date.now() - Date.parse(x.at) < 48 * 3600_000).find((x) => overlap(text, x.text) >= 0.6);
  if (prev) fail(`this repeats what you posted at ${prev.at}: "${prev.text.slice(0, 120)}". Say something new.`, 4); }
const posts = counter('bsky-post'), replies = counter('bsky-reply');
if (!replyTo && posts.get() >= 3) fail('3 posts a day is the limit; put the idea in your journal for tomorrow', 4);
if (replyTo && replies.get() >= 10) fail('10 replies a day is the limit', 4);
if (!replyTo) { const g = predictionGate('game', 'agent', 'post'); if (g) fail(g.replace('game.<metric>', 'game.visits')); }
try {
  const me = await xrpc('GET', 'app.bsky.actor.getProfile', null, { actor: (await session()).did });
  if (!DISCLOSED.test(me.j.description ?? '')) fail('the account\'s profile does not say it is a bot or AI agent. Nothing is posted until it does; the operator sets the profile text. Note it in your journal.', 4);
  const record = { $type: 'app.bsky.feed.post', text, createdAt: new Date().toISOString(), langs: ['en'] };
  if (facets.length) record.facets = facets;
  if (replyTo) {
    if (log.some((x) => x.replyTo === replyTo)) fail('you already answered that post; one reply each', 4);
    const nt = await xrpc('GET', 'app.bsky.notification.listNotifications', null, { limit: '100' });
    const hit = (nt.j.notifications ?? []).find((x) => x.uri === replyTo && ['reply', 'mention', 'quote'].includes(x.reason));
    if (!hit) fail('that post is not among the replies, mentions or quotes sent to this account. You only answer people who wrote to you first (bsky-read notifications).');
    if (hit.author?.did === me.s.did) fail('that is your own post');
    if (log.filter((x) => x.replyToDid === hit.author.did && Date.now() - Date.parse(x.at) < 864e5).length >= 3) fail('3 replies to the same person in a day is enough; let them have the last word', 4);
    const parent = { uri: hit.uri, cid: hit.cid }; record.reply = { root: hit.record?.reply?.root ?? parent, parent };
    if (card) record.embed = { $type: 'app.bsky.embed.external', external: { uri: link('bsky', 'reply'), ...CARD } };
    const r = await xrpc('POST', 'com.atproto.repo.createRecord', { repo: me.s.did, collection: 'app.bsky.feed.post', record });
    replies.bump(); append(LOG, { at: record.createdAt, uri: r.j.uri, cid: r.j.cid, text, replyTo, replyToDid: hit.author.did, tag: card ? 'bsky-reply' : null });
    out({ ok: true, uri: r.j.uri, repliedTo: hit.author.handle, card: !!card, repliesToday: replies.get() }); process.exit(0);
  }
  const uri = link('bsky', tag); record.embed = { $type: 'app.bsky.embed.external', external: { uri, ...CARD } };
  const r = await xrpc('POST', 'com.atproto.repo.createRecord', { repo: me.s.did, collection: 'app.bsky.feed.post', record });
  posts.bump(); append(LOG, { at: record.createdAt, uri: r.j.uri, cid: r.j.cid, text, replyTo: null, tag: tag ? `bsky-${tag}` : 'bsky' });
  out({ ok: true, uri: r.j.uri, url: `https://bsky.app/profile/${me.s.handle}/post/${r.j.uri.split('/').pop()}`, link: uri, postsToday: posts.get(), next: 'visits from this link show up in `game stats` within the hour (subject agent, or src:' + (tag ? `bsky-${tag}` : 'bsky') + ')' });
} catch (e) { out({ ok: false, error: e.message }); process.exit(1); }
