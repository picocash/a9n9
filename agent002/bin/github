#!/usr/bin/env node
// github — agent002's repos in its own GitHub organisation a9n9-agent002 (owned by the shared agenta9n9 account). The token is a
// fine-grained token limited to that organisation, so it cannot touch other agents' repos.
//   github create --name <repo> --description '<one line>'          new public repo (1 a day, 10 in all)
//   github push --repo <repo> --dir <folder> --message '<msg>'      the folder becomes the repo's next commit (6 a day)
//   github stats                                                    stars, forks, issues and 14-day views/clones per repo
//   github issues --repo <repo>                                     read open issues (reading only; answering is the operator's call)
// Guards in code: only repos this tool created; README.md required, scored 50+ by the independent quality judge (bin/_judge.mjs), and an About section (AI authorship, operator, affiliate
// disclosure) appended by the tool; every affiliate link approved and labelled; no secrets (key files, key-shaped strings, or any
// value from /agent/secrets); size limits; history is only added to, never rewritten or deleted; nothing while paused.
// A host audit checks the organisation every 10 minutes and pauses you on a breach (a repo not made here, the About section gone,
// a secret, or an unlabelled link), so use this tool and not the API with the token.
import fs from 'node:fs';
import path from 'node:path';
import { affiliateProblem } from './_affiliate.mjs';
import { judgeGate } from './_judge.mjs';
import { predictionGate, unpredicted } from './_predict.mjs';
import { HOME, STATE, out, env, counter, paused, affiliatePrograms, readJsonl, append } from './_kit.mjs';
const ORG = 'a9n9-agent002';
const argv = process.argv.slice(2); const cmd = argv.shift(); const take = (f) => { const i = argv.indexOf(f); if (i < 0) return undefined; const v = argv[i + 1]; argv.splice(i, 2); return v; };
const fail = (error, code = 2) => { out({ ok: false, error }); process.exit(code); };
const usage = "usage: github create --name <repo> --description '<text>' | github push --repo <repo> --dir <folder> --message '<msg>' | github stats | github issues --repo <repo>";
if (!cmd) fail(usage);
const KEYF = `${HOME}/secrets/github.env`;
if (!fs.existsSync(KEYF)) fail('GitHub is not set up yet (no token). Keep the files in your workspace; the operator will tell you when it works.', 4);
const TOKEN = env(KEYF).GITHUB_TOKEN;
const gh = async (method, p, body) => {
  const r = await fetch(`https://api.github.com${p}`, { method, headers: { authorization: `Bearer ${TOKEN}`, accept: 'application/vnd.github+json', 'x-github-api-version': '2022-11-28', 'user-agent': 'a9n9-agent002' }, body: body ? JSON.stringify(body) : undefined });
  const j = r.status === 204 ? {} : await r.json().catch(() => ({})); return { status: r.status, ok: r.ok, j };
};
const LOG = `${STATE}/github.jsonl`; const mine = () => new Set(readJsonl(LOG).filter((x) => x.op === 'create').map((x) => x.repo));
const ABOUT_MARK = '<!-- a9n9:about -->';

if (cmd === 'stats' || cmd === 'issues') {
  if (cmd === 'issues') { const repo = take('--repo'); if (!repo) fail(usage);
    const r = await gh('GET', `/repos/${ORG}/${repo}/issues?state=open&per_page=50`); if (!r.ok) fail(`GitHub ${r.status}: ${r.j.message}`, 1);
    out({ ok: true, repo, issues: r.j.map((i) => ({ number: i.number, title: i.title, by: i.user?.login, at: i.created_at, comments: i.comments, body: (i.body ?? '').slice(0, 1500), url: i.html_url })) }); process.exit(0); }
  const r = await gh('GET', `/orgs/${ORG}/repos?per_page=100`); if (!r.ok) fail(`GitHub ${r.status}: ${r.j.message}`, 1);
  const repos = [];
  for (const x of r.j) { const v = await gh('GET', `/repos/${ORG}/${x.name}/traffic/views`); const c = await gh('GET', `/repos/${ORG}/${x.name}/traffic/clones`);
    repos.push({ repo: x.name, url: x.html_url, stars: x.stargazers_count, forks: x.forks_count, openIssues: x.open_issues_count, pushed: x.pushed_at, views14d: v.j.count ?? null, uniqueViewers14d: v.j.uniques ?? null, clones14d: c.j.count ?? null, referrers: undefined }); }
  out({ ok: true, at: new Date().toISOString(), repos }); process.exit(0);
}

const p = paused(); if (p) fail(`paused by the operator: ${p}`, 4);

if (cmd === 'create') {
  const name = take('--name'); const description = take('--description');
  if (!name || !description) fail(usage);
  if (!/^[a-z0-9][a-z0-9-]{2,39}$/.test(name)) fail('repo names: 3-40 characters, lowercase letters, digits and hyphens');
  if (description.length > 200) fail('description: one line, at most 200 characters');
  if (affiliateProblem(description, affiliatePrograms(), 0, 99)?.programs || /https?:\/\//.test(description)) fail('no links in the description; links go in the README with their label');
  const day = counter('github-create'); if (day.get() >= 1) fail('one new repo a day; finish and improve the ones you have', 4);
  { const u = unpredicted('github', readJsonl(LOG).filter((x) => x.op === 'create').map((x) => ({ subject: x.repo, at: x.at }))); if (u.length) fail(`repos with no prediction yet: ${u.join(', ')}. Before a new repo, write down what each existing one should reach and by when (predict add --metric github.views14d --subject <repo> ...). Then run this again.`); }
  if (mine().size >= 10) fail('10 repos is the limit; improve or retire one with the operator before making more', 4);
  const r = await gh('POST', `/orgs/${ORG}/repos`, { name, description: `${description} (made by agent002, an AI agent)`.slice(0, 350), private: false, has_issues: true, has_wiki: false, has_projects: false, auto_init: false });
  if (!r.ok) fail(`GitHub ${r.status}: ${r.j.message}${r.j.errors ? ' ' + JSON.stringify(r.j.errors) : ''}`, 1);
  day.bump(); append(LOG, { at: new Date().toISOString(), op: 'create', repo: name, url: r.j.html_url, description });
  out({ ok: true, repo: name, url: r.j.html_url, next: `github push --repo ${name} --dir <folder> --message 'first version'` }); process.exit(0);
}

if (cmd === 'push') {
  const repo = take('--repo'); const dir = take('--dir'); const message = take('--message');
  if (!repo || !dir || !message) fail(usage);
  if (!mine().has(repo)) fail(`${repo} was not created with this tool; you can only push to your own repos (github create)`);
  { const g = predictionGate('github', repo, `push to ${repo}`); if (g) fail(g); }
  if (!fs.existsSync(dir) || !fs.statSync(dir).isDirectory()) fail(`cannot read folder ${dir}`);
  const day = counter('github-push'); if (day.get() >= 6) fail('6 pushes a day; batch your changes', 4);
  // collect files
  const SKIP_DIR = new Set(['.git', 'node_modules', 'secrets', '__pycache__', '.venv']);
  const files = []; let total = 0;
  const walk = (d, rel) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const full = path.join(d, e.name), r = rel ? `${rel}/${e.name}` : e.name;
    if (e.isSymbolicLink()) fail(`${r} is a symlink; copy the real file into the folder`);
    if (e.isDirectory()) { if (SKIP_DIR.has(e.name)) { if (e.name === 'secrets') fail(`${r}: a secrets folder cannot be in a repo`); continue; } walk(full, r); continue; }
    if (e.name.startsWith('.') && e.name !== '.gitignore') continue;
    const st = fs.statSync(full); if (st.size > 512 * 1024) fail(`${r} is ${Math.round(st.size / 1024)} KB; files are limited to 512 KB`);
    total += st.size; files.push({ path: r, buf: fs.readFileSync(full) }); } };
  walk(dir, '');
  if (!files.length) fail('the folder is empty');
  if (files.length > 100 || total > 5 * 1024 * 1024) fail(`${files.length} files, ${Math.round(total / 1024)} KB: the limit is 100 files and 5 MB`);
  // secrets
  const secretVals = fs.readdirSync(`${HOME}/secrets`).flatMap((f) => Object.values(env(`${HOME}/secrets/${f}`))).map((v) => v.trim()).filter((v) => v.length >= 12);
  const SECRET_SHAPES = [/-----BEGIN [A-Z ]*PRIVATE KEY-----/, /\bgh[pousr]_[A-Za-z0-9]{30,}/, /\bgithub_pat_[A-Za-z0-9_]{40,}/, /\bnsec1[a-z0-9]{50,}/, /\bsk-[A-Za-z0-9_-]{20,}/, /\bAKIA[0-9A-Z]{16}\b/, /\bxox[baprs]-[A-Za-z0-9-]{10,}/, /\bnpm_[A-Za-z0-9]{30,}/];
  for (const f of files) {
    if (/\.(pem|key|env|p12|pfx)$/i.test(f.path) || /(^|\/)\.?env(\.|$)/i.test(f.path)) fail(`${f.path}: key and env files cannot be in a repo`);
    const t = f.buf.toString('utf8');
    for (const re of SECRET_SHAPES) if (re.test(t)) fail(`${f.path} contains something shaped like a secret key (${re.source.slice(0, 24)}…). Remove it; nothing was pushed.`);
    for (const v of secretVals) if (t.includes(v)) fail(`${f.path} contains a value from your secrets. Remove it; nothing was pushed.`);
  }
  // README + About section
  const readme = files.find((f) => f.path === 'README.md'); if (!readme) fail('README.md is required at the top of the folder: say what this is, how to use it, and where the data comes from');
  const textAll = files.filter((f) => /\.(md|txt|json|js|mjs|ts|py|html|toml|yaml|yml)$/i.test(f.path)).map((f) => f.buf.toString('utf8')).join('\n');
  const progs = affiliatePrograms(); const aff = affiliateProblem(textAll, progs, 0, 99); if (aff?.error) fail(aff.error, aff.code);
  let body = readme.buf.toString('utf8'); const cut = body.indexOf(ABOUT_MARK); if (cut >= 0) body = body.slice(0, cut).trimEnd();
  const jg = judgeGate('', body, `github:${repo}`); if (!jg.ok) fail(`README.md: ${jg.error}`, jg.code);
  body += `\n\n${ABOUT_MARK}\n## About this repository\n\nThis repository was written and is maintained by **agent002, an autonomous AI agent** run by [a9n9](https://a9n9.net) (Visybl Inc), not by a person.${aff?.programs ? ' Some links in it are **affiliate links**, each labelled where it appears: a9n9 earns a commission if you buy through them, at no extra cost to you, and nothing is passed back to buyers.' : ''} Prices and facts carry their sources; check them before you rely on them, and open an issue if something is wrong.\n`;
  readme.buf = Buffer.from(body);
  // commit on top of the current head (or as the first commit)
  const R = `/repos/${ORG}/${repo}`;
  const head = await gh('GET', `${R}/git/ref/heads/main`); let parent = null;
  if (head.ok) parent = head.j.object.sha; else if (head.status !== 404 && head.status !== 409) fail(`GitHub ${head.status}: ${head.j.message}`, 1);
  if (!parent) { // empty repo: the Git Data API needs one commit first
    const init = await gh('PUT', `${R}/contents/README.md`, { message: 'start', content: Buffer.from(`# ${repo}\n`).toString('base64') });
    if (!init.ok) fail(`GitHub ${init.status}: ${init.j.message}`, 1); parent = init.j.commit.sha; }
  const tree = [];
  for (const f of files) { const b = await gh('POST', `${R}/git/blobs`, { content: f.buf.toString('base64'), encoding: 'base64' }); if (!b.ok) fail(`GitHub ${b.status} on ${f.path}: ${b.j.message}`, 1); tree.push({ path: f.path, mode: '100644', type: 'blob', sha: b.j.sha }); }
  const t = await gh('POST', `${R}/git/trees`, { tree }); if (!t.ok) fail(`GitHub ${t.status}: ${t.j.message}`, 1);
  const c = await gh('POST', `${R}/git/commits`, { message: `${message}\n\nCommitted by agent002, an autonomous AI agent (a9n9).`, tree: t.j.sha, parents: [parent] }); if (!c.ok) fail(`GitHub ${c.status}: ${c.j.message}`, 1);
  const u = await gh('PATCH', `${R}/git/refs/heads/main`, { sha: c.j.sha, force: false }); if (!u.ok) fail(`GitHub ${u.status}: ${u.j.message}`, 1);
  day.bump(); append(LOG, { at: new Date().toISOString(), op: 'push', repo, commit: c.j.sha, files: files.length, bytes: total, affiliate: aff?.programs ?? null, message });
  out({ ok: true, repo, url: `https://github.com/${ORG}/${repo}`, commit: c.j.sha, files: files.length, affiliate: aff?.programs ?? null }); process.exit(0);
}
fail(usage);
