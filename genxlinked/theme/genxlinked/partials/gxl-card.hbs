{{!-- size: lead | small | band ; image optional --}}
<article class="gxl-card gxl-card-{{size}} {{post_class}}">
    <a class="gxl-card-link" href="{{url}}">
        {{#if showImage}}
            <figure class="gxl-card-img">
                {{#if feature_image}}
                    <img srcset="{{img_url feature_image size="s"}} 320w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 960w" sizes="(max-width: 900px) 100vw, 50vw" src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
                {{else}}
                    <span class="gxl-card-noimg gxl-tag-{{primary_tag.slug}}"><span>{{primary_tag.name}}</span></span>
                {{/if}}
            </figure>
        {{/if}}
        <div class="gxl-card-text">
            {{#if showTag}}{{#if primary_tag}}<span class="gxl-kicker">{{primary_tag.name}}</span>{{/if}}{{/if}}
            <h3 class="gxl-card-title">{{title}}</h3>
            {{#if showExcerpt}}{{#if custom_excerpt}}<p class="gxl-card-excerpt">{{custom_excerpt}}</p>{{/if}}{{/if}}
            <p class="gxl-meta">{{#if @site.members_enabled}}{{#match visibility "!=" "public"}}<span aria-label="Members only">&#9679; </span>{{/match}}{{/if}}{{authors separator=", " autolink="false"}} &mdash; <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D"}}</time></p>
        </div>
    </a>
</article>
