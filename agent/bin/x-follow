#!/usr/bin/env node
// x-follow <handle> [--dry-run] — follow an account whose work is on the beat (cap enforced, logged as x.follow)
import { chrome, enforce, ledger, out, policy } from './_lib.mjs';
const args = process.argv.slice(2); const dry = args.includes('--dry-run');
const handle = (args.find(a => !a.startsWith('--')) ?? '').replace(/^@/, '').replace(/^https?:\/\/x\.com\//, '').split(/[/?]/)[0];
if (!handle) { out({ ok: false, error: 'usage: x-follow <handle> [--dry-run]' }); process.exit(2); }
const c = enforce('follows', policy.max_follows_per_day ?? 5);
const { page } = await chrome();
await page.goto(`https://x.com/${handle}`, { waitUntil: 'domcontentloaded' }); await page.waitForTimeout(3500);
const state = await page.evaluate(() => {
  const b = document.querySelector('[data-testid$="-follow"], [data-testid$="-unfollow"]');
  return b ? (b.getAttribute('data-testid').endsWith('-unfollow') ? 'following' : 'not-following') : 'no-button';
});
if (state === 'no-button') { out({ ok: false, handle, error: 'no follow button (account missing, suspended, or page did not load)' }); process.exit(1); }
if (state === 'following') { out({ ok: true, handle, alreadyFollowing: true }); process.exit(0); }
if (dry) { out({ ok: true, handle, dryRun: true, wouldFollow: true, followsToday: c.get() }); process.exit(0); }
await page.locator('[data-testid$="-follow"]').first().click(); await page.waitForTimeout(2500);
const now = await page.evaluate(() => !!document.querySelector('[data-testid$="-unfollow"]'));
if (!now) { out({ ok: false, handle, error: 'follow did not register' }); process.exit(1); }
c.bump();
await ledger({ id: `x:follow:${handle}:${Date.now()}`, type: 'x.follow', channel: 'x', handle, url: `https://x.com/${handle}`, at: new Date().toISOString() });
out({ ok: true, handle, followsToday: c.get(), capPerDay: policy.max_follows_per_day ?? 5 });
process.exit(0);
