#!/usr/bin/env node
// x-follow <handle> — follow an account via the X API (cap enforced, logged as x.follow)
import { enforce, ledger, out, policy } from './_lib.mjs';
import { x, ME_ID, PRICE, apiError } from './_x.mjs';
const handle = (process.argv.slice(2).find(a => !a.startsWith('--')) ?? '').replace(/^@/, '').replace(/^https?:\/\/x\.com\//, '').split(/[/?]/)[0];
if (!handle) { out({ ok: false, error: 'usage: x-follow <handle>' }); process.exit(2); }
const c = enforce('follows', policy.max_follows_per_day ?? 5);
const u = await x('GET', `/users/by/username/${encodeURIComponent(handle)}`, { price: PRICE.userLookup, label: 'user-lookup' });
if (!u.body?.data?.id) { out({ ok: false, handle, error: apiError(u) }); process.exit(1); }
const r = await x('POST', `/users/${ME_ID}/following`, { body: { target_user_id: u.body.data.id }, price: PRICE.followWrite, label: 'follow' });
if (!r.body?.data) { out({ ok: false, handle, error: apiError(r), status: r.status }); process.exit(1); }
if (r.body.data.following === false && !r.body.data.pending_follow) { out({ ok: false, handle, error: 'follow did not register' }); process.exit(1); }
c.bump();
await ledger({ id: `x:follow:${handle}:${Date.now()}`, type: 'x.follow', channel: 'x', handle, url: `https://x.com/${handle}`, at: new Date().toISOString(), via: 'api' });
out({ ok: true, handle, pending: !!r.body.data.pending_follow, followsToday: c.get(), capPerDay: policy.max_follows_per_day ?? 5 });
process.exit(0);
