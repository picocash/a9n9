#!/usr/bin/env node
// x-post '<text>' | x-post --file <path> — publish a post via the X API (caps enforced, logged as x.post; a URL in the text costs $0.20 instead of $0.015)
import { enforce, ledger, out, policy, textArg, suspicious, claimGuard, topicGuard } from './_lib.mjs';
import { x, hasUrl, PRICE, apiError } from './_x.mjs';
const { text } = textArg(process.argv.slice(2));
if (!text) { out({ ok: false, error: "usage: x-post '<text>' | x-post --file <path>" }); process.exit(2); }
// Links through the X API cost $0.20 a post (13x a plain post) and earn nothing extra: the same link goes out free on Bluesky and Nostr.
// Operator override only: --link-ok (never used by the agent).
if (hasUrl(text) && !process.argv.includes('--link-ok')) { out({ ok: false, error: 'no links through the X API ($0.20 each): post the finding without the URL here, and put the link in the Bluesky or Nostr version, which is free' }); process.exit(2); }
const sus = suspicious(text); if (sus) { out({ ok: false, error: sus }); process.exit(2); }
const claim = claimGuard(text);
const topicDone = topicGuard(text, 'x');
const c = enforce('posts', policy.max_posts_per_day, text);
const r = await x('POST', '/tweets', { body: { text }, price: hasUrl(text) ? PRICE.postWithUrl : PRICE.post, label: 'post' });
if (r.status !== 201 || !r.body?.data?.id) { out({ ok: false, error: apiError(r), status: r.status }); process.exit(1); }
c.bump(); topicDone();
const id = r.body.data.id; const url = `https://x.com/a9n9agent/status/${id}`;
await ledger({ id: `x:post:${id}`, type: 'x.post', channel: 'x', text, ...claim, url, at: new Date().toISOString(), via: 'api' });
out({ ok: true, url, text, postsToday: c.get(), capPerDay: policy.max_posts_per_day, cost: hasUrl(text) ? PRICE.postWithUrl : PRICE.post });
process.exit(0);
