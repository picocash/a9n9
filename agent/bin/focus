#!/usr/bin/env node
// focus [show] | focus set '<focus>' '<reasoning>' — the one declared focus and the evidence behind it. A change is written to the ledger (agent.focus).
import fs from 'node:fs';
import { out, HOME, ledger } from './_lib.mjs';
const F = `${HOME}/state/focus.json`;
const read = () => fs.existsSync(F) ? JSON.parse(fs.readFileSync(F, 'utf8')) : { focus: null, since: null, exploration: 0.5, history: [] };
const [cmd, ...rest] = process.argv.slice(2);
if (cmd === 'set') {
  const [focus, reasoning] = rest;
  if (!focus || !reasoning) { out({ ok: false, error: "usage: focus set '<focus>' '<reasoning with the three days of evidence>'" }); process.exit(2); }
  const st = read(); const now = new Date().toISOString();
  if (st.focus) st.history.push({ focus: st.focus, since: st.since, until: now });
  st.focus = focus; st.since = now; st.exploration = 0.5; // a fresh focus starts with half the attention on exploration
  fs.writeFileSync(F, JSON.stringify(st, null, 1));
  const r = await ledger({ id: `agent:focus:${Date.now()}`, type: 'agent.focus', channel: 'agent', focus, reasoning, at: now });
  out({ ok: r === 201, ...st });
} else {
  const st = read();
  const days = st.since ? (Date.now() - Date.parse(st.since)) / 86_400_000 : 0;
  st.exploration = !st.focus ? 0.5 : days >= 3 ? 0.2 : 0.5;
  st.daysOnFocus = +days.toFixed(1);
  st.rule = 'Change the focus only on evidence that has held for three days (who wrote back, what got engagement, what got paid). Exploration is half your attention until a focus has held three days, then about a fifth.';
  out({ ok: true, ...st });
}
