#!/usr/bin/env node
// nostr-post "<text>" — publish a kind-1 note, 4/day. Nostr is a mirror (2026-11-07): a note must repeat something you published
// on Bluesky or X in the last 12 hours. Week 1 showed every Nostr reply came from bots, spam or solicitors, so Nostr gets no work of its own.
import fs from 'node:fs';
import { claimGuard, env, enforce, out, topicGuard, overlap, HOME } from './_lib.mjs';
const text = process.argv.slice(2).join(' ').trim();
if (!text) { out({ ok: false, error: 'usage: nostr-post "<text>"' }); process.exit(2); }
if (!/^correction\b/i.test(text)) {
  const pf = `${HOME}/state/published.jsonl`; const pub = fs.existsSync(pf) ? fs.readFileSync(pf, 'utf8').trim().split('\n').map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean) : [];
  const src = pub.filter((p) => (p.net === 'bsky' || p.net === 'x') && Date.now() - Date.parse(p.at) < 12 * 3600_000).find((p) => overlap(text, p.text) >= 0.5);
  if (!src) { out({ ok: false, error: 'Nostr is a mirror: post this on Bluesky (or X) first, then post the same finding here. Nothing was published.' }); process.exit(2); }
}
claimGuard(text);
const topicDone = topicGuard(text, 'nostr');
const c = enforce('nostr', 4, text);
const e = env('/home/ubuntu/a9n9/secrets/nostr.env');
const res = await fetch('http://127.0.0.1:8830/v1/notes', { method: 'POST', headers: { 'content-type': 'application/json', authorization: `Bearer ${e.NOSTR_API_TOKEN}` }, body: JSON.stringify({ text }) });
const j = await res.json(); if (res.ok) { c.bump(); topicDone(); }
out({ ok: res.ok, ...j, nostrToday: c.get() });
process.exit(res.ok ? 0 : 1);
