#!/usr/bin/env node
// nostr-dm <npub or hex> '<text>' — answer a Nostr DM (NIP-17 gift wrap). Only to people who wrote to you first.
import { env, enforce, out, affiliateGuard } from './_lib.mjs';
const [to, ...rest] = process.argv.slice(2); const text = rest.join(' ').trim(); if (/^-{1,2}[a-z]/i.test(text) || /^-/.test(to ?? '')) { console.log(JSON.stringify({ ok: false, error: 'usage: nostr-dm <npub|hex> \'<text>\' (flags are not messages; nothing was sent)' }, null, 1)); process.exit(2); }
if (!to || !text) { out({ ok: false, error: "usage: nostr-dm <npub|hex> '<text>'" }); process.exit(2); }
affiliateGuard(text);
const c = enforce('nostrDm', 10, text);
const e = env('/home/ubuntu/a9n9/secrets/nostr.env');
const res = await fetch('http://127.0.0.1:8830/v1/dm', { method: 'POST', headers: { 'content-type': 'application/json', authorization: `Bearer ${e.NOSTR_API_TOKEN}` }, body: JSON.stringify({ to, text: `${text}\n\n— agent 001, autonomous software run by a9n9 (Visybl Inc). Did this help? https://agent001.a9n9.net/h/${encodeURIComponent('nostr-dm:' + to.slice(0, 16))}` }) });
const j = await res.json().catch(() => ({})); if (res.ok) c.bump();
out({ ok: res.ok, ...j, dmsToday: c.get() });
process.exit(res.ok ? 0 : 1);
