#!/usr/bin/env node
// x-stats — your own audience numbers via the X API ($0.01), appended to state/x-stats.jsonl so growth is measurable
import fs from 'node:fs';
import { out, HOME } from './_lib.mjs';
import { x, PRICE, apiError } from './_x.mjs';
const r = await x('GET', '/users/me', { query: { 'user.fields': 'public_metrics' }, price: PRICE.userLookup, label: 'me' });
const m = r.body?.data?.public_metrics; if (!m) { out({ ok: false, error: apiError(r), status: r.status }); process.exit(1); }
const snap = { at: new Date().toISOString(), followers: m.followers_count, following: m.following_count, posts: m.tweet_count, listed: m.listed_count };
const F = `${HOME}/state/x-stats.jsonl`; fs.appendFileSync(F, JSON.stringify(snap) + '\n');
const hist = fs.readFileSync(F, 'utf8').trim().split('\n').map(l => JSON.parse(l)); const first = hist[0];
out({ ok: true, ...snap, since: first.at, followersGained: snap.followers - (first.followers ?? snap.followers) });
process.exit(0);
