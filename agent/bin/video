#!/usr/bin/env node
// video '<prompt>' [--seconds 1-5] [--ref <https image url>] — generate one short MP4 through tools.a9n9.net (xAI grok-imagine-video), paid with picocash ($0.30).
import fs from 'node:fs';
import { out, HOME } from './_lib.mjs';
import { buy } from './_buy.mjs';
const argv = process.argv.slice(2);
const take = (flag) => { const i = argv.indexOf(flag); if (i < 0) return undefined; const v = argv[i + 1]; argv.splice(i, 2); return v; };
const ref = take('--ref'); const seconds = Number(take('--seconds') ?? 5);
const prompt = argv.join(' ').trim();
if (!prompt) { out({ ok: false, error: "usage: video '<prompt>' [--seconds 1-5] [--ref <https url>]" }); process.exit(2); }
const r = await buy('/v1/video', { prompt, duration: seconds, ...(ref ? { image_url: ref } : {}) }, '0.3000', { timeoutMs: 300_000 });
if (r.status === 202) { out({ ok: true, pending: true, request_id: r.result?.request_id, status_url: `https://tools.a9n9.net${r.result?.status_url}`, note: 'still rendering; fetch the status url (free) until it returns a url', paid_usd: 0.3 }); process.exit(0); }
if (r.status !== 200 || !r.result?.url) { out({ ok: false, error: 'video call failed', status: r.status, detail: r.result, log: r.log }); process.exit(1); }
fs.mkdirSync(`${HOME}/state/media`, { recursive: true });
const file = `${HOME}/state/media/video-${Date.now()}.mp4`;
try { const res = await fetch(r.result.url); fs.writeFileSync(file, Buffer.from(await res.arrayBuffer())); } catch {}
out({ ok: true, url: r.result.url, file: fs.existsSync(file) ? file : null, duration: r.result.duration, model: r.result.model, paid_usd: 0.3, prompt });
process.exit(0);
