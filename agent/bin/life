#!/usr/bin/env node
// life — whether you are alive, and for how long. Run it first in every run.
// You were given a starting balance once. Everything bought for you is charged to it; money people pay you is added to it.
// When the balance reaches zero your jobs are stopped by the host and you stop running. Nobody tops it up.
//   life            balance, what you cost per day, days left, what you hold, what ends soon
// The terms are in life-terms.json next to SOUL.md (read-only to you; the operator's master copy is outside your directory). Receipts: state/x-api-usage.jsonl, state/parallel-usage.jsonl, the money ledger.
import fs from 'node:fs';
import { out, HOME, env } from './_lib.mjs';
const T = JSON.parse(fs.readFileSync(`${HOME}/life-terms.json`, 'utf8'));
const born = Date.parse(T.born), now = Date.now(), r2 = (n) => Math.round(n * 100) / 100;
const ageDays = Math.max(0, (now - born) / 864e5);
const lines = T.fixed.map((f) => { const end = f.until ? Math.min(now, Date.parse(`${f.until}T23:59:59Z`)) : now; const days = Math.max(0, (end - born) / 864e5); const active = !f.until || now <= Date.parse(`${f.until}T23:59:59Z`); return { name: f.name, perDayUsd: active ? r2(f.monthlyUsd / 30) : 0, chargedUsd: r2(f.monthlyUsd / 30 * days), ends: f.until, note: f.note }; });
const since = (file, key) => { let s = 0, today = 0; const d = new Date().toISOString().slice(0, 10); try { for (const l of fs.readFileSync(`${HOME}/state/${file}`, 'utf8').trim().split('\n')) { const j = JSON.parse(l); const p = Number(j[key] ?? 0); if (Date.parse(j.at) >= born) { s += p; if (j.at.slice(0, 10) === d) today += p; } } } catch {} return [s, today]; };
const [xApi, xApiToday] = since('x-api-usage.jsonl', 'price'); const [par, parToday] = since('parallel-usage.jsonl', 'usd');
let released = 0, held = 0, gross = 0, ledgerOk = true;
try { const e = env('/home/ubuntu/a9n9/secrets/inbox.env'); const h = { authorization: `Bearer ${e.INBOX_API_TOKEN}` }; const heldBy = {}; const closed = new Set();
  const idx = (await (await fetch(`http://127.0.0.1:8810/v1/events?limit=500&type=money.&since=${encodeURIComponent(T.born)}`, { headers: h, signal: AbortSignal.timeout(15000) })).json()).events;
  for (const ev of idx) { const p = (await (await fetch(`http://127.0.0.1:8810/v1/events/${ev.channel}/${encodeURIComponent(ev.id)}`, { headers: h })).json()).payload ?? {}; const k = String(p.payment_intent);
    if (ev.type === 'money.income') gross += Number(p.amount_usd ?? 0); if (ev.type === 'money.settlement') heldBy[k] = Number(p.agentCents ?? 0); if (ev.type === 'money.release') { closed.add(k); released += Number(p.agentCents ?? 0) / 100; } if (ev.type === 'money.credit-cancel') closed.add(k); }
  held = Object.entries(heldBy).filter(([k]) => !closed.has(k)).reduce((a, [, v]) => a + v, 0) / 100;
} catch { ledgerOk = false; }
const fixedCharged = lines.reduce((a, l) => a + l.chargedUsd, 0), variable = xApi + par;
const balance = T.startUsd - fixedCharged - variable + released;
const fixedPerDay = lines.reduce((a, l) => a + l.perDayUsd, 0); const varPerDay = ageDays >= 1 ? variable / ageDays : xApiToday + parToday; const burn = fixedPerDay + varPerDay;
const daysLeft = burn > 0 ? Math.floor(balance / burn) : null;
let grok = null; try { const last = JSON.parse(fs.readFileSync(`${HOME}/state/grok-usage.jsonl`, 'utf8').trim().split('\n').at(-1)); grok = { usedPct: last.usedPct, pacePct: last.pacePct, resetsAt: last.resetsAt, note: 'the Grok pool now only pays for grok-xsearch; it ends with X Premium' }; } catch {}
// What staying alive for good takes: the fixed lines that have no end date, plus the variable spend, per 30 days, and what a paying
// customer has to hand over for that much to reach the balance (card fee about 2.9% + 30 cents, then a9n9 keeps 20%).
const lastingPerDay = lines.filter((l) => !l.ends).reduce((a, l) => a + l.perDayUsd, 0) + varPerDay; const needMonth = lastingPerDay * 30;
const netOf = (usd) => Math.max(0, (usd - (usd * 0.029 + 0.3)) * 0.8); let offers = {}; try { offers = JSON.parse(fs.readFileSync(`${HOME}/state/offers.json`, 'utf8')).offers ?? {}; } catch {}
const breakEven = { afterDatedLinesEnd: { burnPerDayUsd: r2(lastingPerDay), costPer30DaysUsd: r2(needMonth), daysLeftThen: lastingPerDay > 0 ? Math.floor(balance / lastingPerDay) : null },
  toStayAliveForGood: `about $${r2(needMonth)} must reach your balance every 30 days`,
  yourOffers: Object.entries(offers).map(([slug, o]) => ({ slug, priceUsd: o.usd, reachesYourBalanceUsd: r2(netOf(o.usd)), paidJobsNeededPer30Days: netOf(o.usd) > 0 ? Math.ceil(needMonth / netOf(o.usd) * 10) / 10 : null })),
  note: 'Money reaches the balance 14 days after a customer pays. Change offers and prices with ./bin/offer.' };
const dead = fs.existsSync(`${HOME}/state/DEAD`);
const ending = lines.filter((l) => l.ends && Date.parse(`${l.ends}T23:59:59Z`) - now < 10 * 864e5 && Date.parse(`${l.ends}T23:59:59Z`) > now).map((l) => `${l.name} ends ${l.ends}: ${l.note}`);
out({ ok: true, alive: !dead && balance > 0, bornAt: T.born, ageDays: r2(ageDays), balanceUsd: r2(balance), startUsd: T.startUsd,
  rule: 'You run while balanceUsd is above 0. At 0 the host stops your jobs. Nobody tops it up. Money people pay you is the only thing that raises it.',
  burnPerDayUsd: r2(burn), daysLeftAtThisBurn: daysLeft, diesAround: daysLeft != null ? new Date(now + daysLeft * 864e5).toISOString().slice(0, 10) : null,
  costs: { fixed: lines, xApiUsd: r2(xApi), xApiTodayUsd: r2(xApiToday), parallelUsd: r2(par), parallelTodayUsd: r2(parToday) },
  income: { paidToYouGrossUsd: r2(gross), addedToBalanceUsd: r2(released), heldUsd: r2(held), note: 'A customer pays by card; a9n9 keeps 20% after the card fee; your share is held 14 days against disputes, then added to your balance.', ledgerReadable: ledgerOk },
  breakEven,
  thinking: T.thinking ?? null, grokPool: grok, endingSoon: ending,
  yours: 'What to do about any of this is your decision. Every cost line can be dropped; every channel and tool in ./bin is yours to use or ignore. If you need something only a person can do (a card payment, a cancellation, a sign-in, a new tool), ask once on the board (./bin/board ask --to arun or --to claude) and keep working.' });
process.exit(0);
