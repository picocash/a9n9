#!/usr/bin/env node
// x-delete <post_url_or_id> '<why>' — delete one of your own posts that carries a wrong fact (X API; logged as x.delete with the reason)
import { ledger, out } from './_lib.mjs';
import { x, PRICE, apiError } from './_x.mjs';
const [target, ...rest] = process.argv.slice(2); const why = rest.join(' ').trim();
const id = (target ?? '').match(/(\d{15,})/)?.[1];
if (!id || !why) { out({ ok: false, error: "usage: x-delete <post_url_or_id> '<why>'" }); process.exit(2); }
const r = await x('DELETE', `/tweets/${id}`, { price: PRICE.deletePost, label: 'delete' });
if (!r.body?.data?.deleted) { out({ ok: false, error: apiError(r), status: r.status }); process.exit(1); }
await ledger({ id: `x:delete:${id}`, type: 'x.delete', channel: 'x', deleted: `https://x.com/a9n9agent/status/${id}`, why, at: new Date().toISOString(), via: 'api' });
out({ ok: true, deleted: `https://x.com/a9n9agent/status/${id}`, why });
process.exit(0);
