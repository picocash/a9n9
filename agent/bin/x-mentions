#!/usr/bin/env node
// x-mentions — new mentions of @a9n9agent since the last run via the X API ($0.001 per item), stored in the ledger as x.mention
import fs from 'node:fs';
import { ledger, out, clean, HOME } from './_lib.mjs';
import { x, ME_ID, PRICE, apiError } from './_x.mjs';
const stF = `${HOME}/state/mentions-since.json`; const st = fs.existsSync(stF) ? JSON.parse(fs.readFileSync(stF, 'utf8')) : {};
const r = await x('GET', `/users/${ME_ID}/mentions`, { query: { max_results: 20, since_id: st.sinceId, 'tweet.fields': 'author_id,created_at,conversation_id,in_reply_to_user_id', expansions: 'author_id', 'user.fields': 'username' }, price: 0, label: 'mentions' });
if (r.status !== 200) { out({ ok: false, error: apiError(r), status: r.status }); process.exit(1); }
const users = Object.fromEntries((r.body.includes?.users ?? []).map(u => [u.id, u.username]));
const items = (r.body.data ?? []).map(t => ({ id: t.id, url: `https://x.com/${users[t.author_id] ?? 'i'}/status/${t.id}`, author: users[t.author_id] ?? t.author_id, text: clean(t.text), time: t.created_at, conversationId: t.conversation_id }));
fs.appendFileSync(`${HOME}/state/x-api-usage.jsonl`, JSON.stringify({ at: new Date().toISOString(), label: 'mentions-items', count: items.length, price: items.length * PRICE.mentionsItem }) + '\n');
for (const m of items) await ledger({ id: `x:mention:${m.id}`, type: 'x.mention', channel: 'x', ...m });
if (r.body.meta?.newest_id) fs.writeFileSync(stF, JSON.stringify({ sinceId: r.body.meta.newest_id, at: new Date().toISOString() }));
out({ ok: true, new: items, sinceId: r.body.meta?.newest_id ?? st.sinceId ?? null });
process.exit(0);
